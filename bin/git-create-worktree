#!/usr/bin/env bash
# Compatibility wrapper for git-create-worktree.

set -Eeuo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root_dir="$(cd "$script_dir/.." && pwd)"

if [[ -x "$root_dir/ravn-wt" ]]; then
  exec "$root_dir/ravn-wt" create "$@"
elif [[ -x /opt/ravn-wt/ravn-wt ]]; then
  exec /opt/ravn-wt/ravn-wt create "$@"
else
  exec ravn-wt create "$@"
fi
